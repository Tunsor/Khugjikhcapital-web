{
  "name": "khugjikh-capital-api",
  "version": "1.0.0",
  "private": true,
  "description": "Khugjikh Capital REST API (Express + TypeScript)",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
