# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:3000
# Set to true only when running behind a trusted reverse proxy
# (Vercel, Nginx, Cloudflare...). Enables X-Forwarded-For parsing.
TRUST_PROXY=false
LOG_LEVEL=info

# ─── Supabase ─────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Security ─────────────────────────────────────────
# Cloudflare Turnstile secret for the loan application form
TURNSTILE_SECRET_KEY=
# Optional: reject Turnstile tokens issued for other hostnames
TURNSTILE_EXPECTED_HOSTNAME=
# Bearer secret for the scheduled news sync job (min 32 chars)
CRON_SECRET=
# HMAC secret for rate-limit keys (min 32 chars)
RATE_LIMIT_HASH_SECRET=
# Shared secret the Next.js server sends as X-Internal-Api-Key so SSR
# requests skip the per-IP limit on public reads (min 32 chars).
# Must match INTERNAL_API_SECRET in the frontend env.
INTERNAL_API_SECRET=
