# Backend REST API base URL, as reachable from the browser
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional: internal API URL for server-side rendering (e.g. Docker network)
# API_URL=http://api:4000/api/v1
# Server-only. Same value as INTERNAL_API_SECRET in the backend env; lets
# server-side rendering skip the API's per-IP rate limit. Never NEXT_PUBLIC_.
INTERNAL_API_SECRET=

# Supabase Auth (admin sign-in only). Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Cloudflare Turnstile site key (loan application form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Public site URL (sitemap, robots, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
